# ── PlatformIO Build Files ────────────────────────────────────
.pio/
.vscode/.platformio/

# ── Python cache ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── ML Model (large binary, regenerated by running run.py) ────
models/*.pkl

# ── Database (auto-created at runtime) ────────────────────────
data/*.db
data/*.sqlite

# ── Virtual environment ────────────────────────────────────────
venv/
.venv/
env/

# ── OS / IDE junk ─────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ── Temp audio files from voice assistant ─────────────────────
temp_voice.mp3

# ── Streamlit secrets ─────────────────────────────────────────
.streamlit/secrets.toml
